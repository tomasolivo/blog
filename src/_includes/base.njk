<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · {{ site.title }}</title>
  <link rel="stylesheet" href="/assets/css/style.css">
  <script>
    try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <a class="orb" href="/" aria-label="Home"></a>
  <button class="theme-toggle" type="button" aria-label="Cambiar tema">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2"/>
      <g stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <path d="M12 1.8v2.4M12 19.8v2.4M1.8 12h2.4M19.8 12h2.4M4.8 4.8l1.7 1.7M17.5 17.5l1.7 1.7M4.8 19.2l1.7-1.7M17.5 6.5l1.7-1.7"/>
      </g>
    </svg>
  </button>

  <div class="stage">
    <div class="backdrop" aria-hidden="true">
      {%- for layer in backdrop %}
      <div class="backdrop__layer{% if layer.fade %} backdrop__layer--fade{% endif %}" data-depth="{{ layer.depth }}"
           style="--bleed: {{ layer.bleed or 0 }}px; --fit: {{ layer.fit or 'cover' }}; --pos: {{ layer.position or 'center' }};{% if layer.opacity %} opacity: {{ layer.opacity }};{% endif %}{% if layer.blend %} mix-blend-mode: {{ layer.blend }};{% endif %}">
        <img src="{{ layer.src }}" alt="" decoding="async">
      </div>
      {%- endfor %}
    </div>

    <nav class="tags" data-depth="30" aria-label="Tags">
      <svg class="tags__arc" viewBox="0 0 880 260" aria-hidden="true">
        <path d="M352 22 C320 140 200 205 -40 232"/>
      </svg>
      {%- for tag in site.tags %}
      <a class="tag" href="{{ tag.url }}" style="left: {{ tag.x }}px; top: {{ tag.y }}px">{{ tag.label }} ({{ tag.count }})</a>
      {%- endfor %}
    </nav>

    <main class="panel" data-depth="28">
      <span class="panel__edge panel__edge--top"></span>
      <span class="panel__edge panel__edge--diag"></span>
      <span class="panel__edge panel__edge--bottom"></span>
      <span class="panel__edge panel__edge--right"></span>

      <ul class="menu">
        {%- for item in site.nav %}
        <li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>

      <section class="panel__body">
        <h1>{{ title }}</h1>
        {%- for group in entries %}
        <div class="group">
          <p class="group__date">:: {{ group.date }}</p>
          <ul>
            {%- for item in group.items %}
            <li><a href="{{ item.url }}">{{ item.title }}</a></li>
            {%- endfor %}
          </ul>
        </div>
        {%- endfor %}
        {{ content | safe }}
      </section>
    </main>
  </div>

  <script src="/assets/js/parallax.js" defer></script>
</body>
</html>
